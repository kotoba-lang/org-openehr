;; No dependencies. ADL is a textual grammar over strings; a leaf that
;; dragged in an XML/YAML/JSON library or an RM-object framework would
;; defeat the point, which is that this workspace can hold a real openEHR
;; archetype parser without also holding a Java/Ruby/Python archetype
;; toolchain behind it.
{:paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
